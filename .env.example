# PORT: Port to bind server on (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/tenderiq)
MONGODB_URI=
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Production backend URL for frontend (e.g. https://tenderiq-backend.onrender.com). Leave empty for relative /api routes.
VITE_API_URL=

# CORS_ORIGIN: Allowed CORS origins for backend (defaults to * if not set)
CORS_ORIGIN=*
